{
  "name": "achery-workshop-site",
  "private": true,
  "version": "0.5.1",
  "description": "workshop.achery.dev \u2014 the public documentation site for achery-ui",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/roboto-slab": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "achery-ui": "workspace:*",
    "marked": "18.0.14",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native-safe-area-context": "5.8.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "0.21.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.3",
    "@vanilla-extract/vite-plugin": "^5.2.2",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "4.1.11"
  }
}
